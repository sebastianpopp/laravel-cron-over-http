{
    "name": "sebastianpopp/laravel-cron-over-http",
    "description": "Run your Laravel cron jobs and queue over HTTP.",
    "keywords": [
        "Sebastian Popp",
        "laravel",
        "laravel-cron-over-http"
    ],
    "homepage": "https://github.com/sebastianpopp/laravel-cron-over-http",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Popp",
            "email": "git@sebastianpopp.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^5.3.5"
    },
    "autoload": {
        "psr-4": {
            "SebastianPopp\\CronOverHttp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SebastianPopp\\CronOverHttp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SebastianPopp\\CronOverHttp\\CronOverHttpServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
